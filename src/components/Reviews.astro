---
/**
 * Отзывы.
 *
 * Наверху — настоящая агрегированная оценка со ссылкой на источник. Ниже —
 * карточки, каждая честно помечена как образец вёрстки.
 *
 * Разделение принципиальное. Рейтинг 5,0 при семи оценках — проверяемый
 * факт из карточки компании. А текстов этих отзывов у нас нет, и сочинять
 * отзыв от лица несуществующего человека нельзя: это уже не правдоподобная
 * заглушка, а поддельное свидетельство. Пометка «образец» на карточке стоит
 * ровно поэтому и снимается только вместе с настоящим текстом.
 */
import Reveal from './Reveal.astro';
import { client } from '../config';
import { copy } from '../config/copy';

const { reviews, contacts } = client;
const card = contacts.mapCard;
const hasSamples = reviews.some((review) => review.sample);
---

<section class="section reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="shell">
    <div class="reviews__head">
      <div class="reviews__intro">
        <span class="eyebrow">{copy.reviews.eyebrow}</span>
        <h2 id="reviews-title">{copy.reviews.title}</h2>
      </div>

      {
        card && (
          <a class="reviews__source" href={card.href} target="_blank" rel="noopener">
            <span class="reviews__rating">{card.rating.toFixed(1).replace('.', ',')}</span>
            <span class="reviews__source-body">
              <span class="reviews__stars" aria-label={`${copy.a11y.ratingStars} ${card.rating} ${copy.a11y.outOfFive}`}>
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m8 1.6 1.9 4 4.3.6-3.1 3 .7 4.3L8 11.5 4.2 13.5l.7-4.3-3.1-3 4.3-.6z" />
                  </svg>
                ))}
              </span>
              <span class="reviews__source-text">
                {card.count} {copy.reviews.countLabel} · {card.source}
              </span>
              <span class="reviews__source-link">{copy.reviews.openSource}</span>
            </span>
          </a>
        )
      }
    </div>

    <ul class="reviews__grid">
      {
        reviews.map((review, i) => (
          <Reveal as="li" index={i} class="reviews__cell">
            <blockquote class="review">
              {review.sample && <span class="review__badge mono mono--sm">{copy.reviews.sampleBadge}</span>}
              <p class="review__text">{review.text}</p>
              <footer class="review__foot">
                <cite class="review__author">{review.author}</cite>
                <span class="review__object mono mono--sm">
                  {review.object} · {review.date}
                </span>
              </footer>
            </blockquote>
          </Reveal>
        ))
      }
    </ul>

    {hasSamples && <p class="reviews__note mono mono--sm">{copy.reviews.sampleNote}</p>}
  </div>
</section>

<style>
  .reviews__head {
    display: grid;
    gap: var(--sp-item);
    margin-bottom: var(--sp-block);
  }

  .reviews__source {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 18px 24px;
    border: var(--hair) solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .reviews__source:hover {
    border-color: var(--accent);
  }

  .reviews__rating {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tr-display);
    color: var(--accent-text);
  }

  .reviews__source-body {
    display: grid;
    gap: 4px;
  }

  .reviews__stars {
    display: flex;
    gap: 2px;
  }

  .reviews__stars svg {
    width: 14px;
    height: 14px;
    fill: var(--accent);
  }

  .reviews__source-text {
    font-size: var(--fs-small);
  }

  .reviews__source-link {
    font-size: 13px;
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reviews__grid {
    display: grid;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .review {
    position: relative;
    height: 100%;
    margin: 0;
    padding: clamp(22px, 2.6vw, 30px);
    background: var(--surface);
    border: var(--hair) solid var(--line-soft);
    border-radius: var(--r-lg);
    display: flex;
    flex-direction: column;
  }

  /* Пометка видна, но не кричит: она честная оговорка, а не дисклеймер
     поверх работы. Читается тем, кто присматривается — то есть тем,
     кто и стал бы проверять. */
  .review__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: var(--bg-deep);
    color: var(--fg-muted);
    letter-spacing: 0.06em;
  }

  .review__text {
    flex: 1;
    padding-right: 60px;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .review__foot {
    margin-top: 22px;
    padding-top: 18px;
    border-top: var(--hair) solid var(--line);
  }

  .review__author {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .review__object {
    display: block;
    margin-top: 4px;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  .reviews__note {
    margin-top: var(--sp-item);
    max-width: 80ch;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  @media (min-width: 760px) {
    .reviews__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
