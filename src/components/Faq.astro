---
/**
 * Вопросы и ответы.
 *
 * Нативные <details>: раскрытие работает без единой строчки JavaScript,
 * клавиатурой и скринридером — тоже, и текст ответов находится поиском по
 * странице даже в закрытом состоянии.
 */
import { client } from '../config';
import { copy } from '../config/copy';

const { faq } = client;
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="shell">
    <div class="faq__grid">
      <div class="faq__head">
        <span class="eyebrow">{copy.faq.eyebrow}</span>
        <h2 id="faq-title">{copy.faq.title}</h2>
      </div>

      <div class="faq__list">
        {
          faq.map((item) => (
            <details class="faq__item" name="faq">
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__sign" aria-hidden="true" />
              </summary>
              <div class="faq__a">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--sp-block);
  }

  .faq__list {
    border-top: var(--hair) solid var(--line);
  }

  .faq__item {
    border-bottom: var(--hair) solid var(--line);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 22px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-size: clamp(17px, 1.7vw, 20px);
    font-weight: 500;
    line-height: 1.35;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  /* Плюс из двух линий на псевдоэлементах: одна отрисовка, поворот второй
     превращает его в минус, и не нужно менять разметку при раскрытии. */
  .faq__sign {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: var(--accent-text);
    transition: transform var(--dur-fast) var(--ease);
  }

  .faq__sign::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sign::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding-bottom: 24px;
  }

  .faq__a p {
    max-width: 74ch;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--fg-muted);
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: clamp(32px, 4vw, 72px);
      align-items: start;
    }

    .faq__head {
      position: sticky;
      top: calc(var(--header-h-min) + 16px);
    }
  }
</style>
