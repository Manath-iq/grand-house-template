---
/**
 * Липкая панель действия на мобильном.
 *
 * Появляется после первого экрана: пока герой на виду, кнопки в нём и так
 * под рукой, а панель поверх них — просто шум. Дальше по странице
 * ближайшая кнопка может оказаться в двух экранах прокрутки, и именно там
 * человек решает написать.
 *
 * Два действия и оба привычные: звонок и WhatsApp. Расчёт сметы сюда не
 * ставится — он требует минуты, а панель нужна для «связаться сейчас».
 */
import { client } from '../config';
import { copy } from '../config/copy';
---

<div class="sticky" data-sticky hidden>
  <a class="sticky__btn sticky__btn--ghost" href={`tel:+${client.contacts.phoneRaw}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <path
        d="M5 4h3.2l1.6 4-2 1.4a12 12 0 0 0 5.8 5.8l1.4-2 4 1.6V19a1 1 0 0 1-1.1 1A15.6 15.6 0 0 1 4 6.1 1 1 0 0 1 5 4Z"
        stroke-linejoin="round"
      />
    </svg>
    {copy.sticky.call}
  </a>

  {
    client.contacts.whatsapp && (
      <a
        class="sticky__btn sticky__btn--primary"
        href={`https://wa.me/${client.contacts.whatsapp}`}
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5v-.5l-.8-1.8c-.2-.4-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.1.6 2.5.5a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z" />
        </svg>
        {copy.sticky.whatsapp}
      </a>
    )
  }
</div>

<style>
  .sticky {
    position: fixed;
    left: 0;
    right: 0;
    /* Панель садится на системную полосу жестов iPhone, если не учесть
       безопасную зону: нижняя кнопка тогда наполовину под ней. */
    bottom: 0;
    z-index: var(--z-sticky);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 10px var(--pad) calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--c-paper) 92%, transparent);
    backdrop-filter: blur(12px);
    border-top: var(--hair) solid var(--line);
    transform: translateY(100%);
    transition: transform var(--dur) var(--ease);
  }

  .sticky[data-in] {
    transform: none;
  }

  .sticky__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 50px;
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }

  .sticky__btn--primary {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .sticky__btn--ghost {
    background: var(--surface);
    border: var(--hair) solid var(--line);
    color: var(--fg);
  }

  /* На большом экране всегда виден телефон в шапке — панель там лишняя. */
  @media (min-width: 900px) {
    .sticky {
      display: none;
    }
  }
</style>

<script>
  /**
   * Панель показывается, когда первый экран уехал вверх.
   *
   * Наблюдатель, а не слушатель scroll: обработчик прокрутки на телефоне
   * дёргается сотни раз в секунду и стоит заметного времени в главном потоке
   * ровно тогда, когда человек листает.
   */
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (bar && hero) {
    bar.removeAttribute('hidden');
    new IntersectionObserver(
      ([entry]) => bar.toggleAttribute('data-in', !entry.isIntersecting),
      { rootMargin: '-40% 0px 0px 0px' }
    ).observe(hero);
  }
</script>
