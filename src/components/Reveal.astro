---
/**
 * Появление блока при входе в экран.
 *
 * Наблюдатель один на всю страницу и живёт в index.astro — здесь только
 * класс и задержка. Библиотека анимаций тут не нужна: пять правил CSS и
 * IntersectionObserver весят ноль и не блокируют главный поток.
 *
 * ВАЖНО: остальные пропсы обязаны прокидываться на сам элемент.
 *
 * Astro скоупит стили атрибутом data-astro-cid-*, и на элемент, который
 * рисует не сам компонент, а его потомок, этот атрибут не попадает — он
 * приходит сюда обычным пропом. Без ...rest ниже правила вида
 * `.trust__item[data-astro-cid-…]` не совпадают ни с чем, и вся раскладка
 * карточки молча пропадает: ошибка не видна ни в консоли, ни в сборке,
 * только глазами на странице.
 */
interface Props {
  /** Порядковый номер в группе — из него считается лесенка. */
  index?: number;
  as?: 'div' | 'li' | 'article' | 'section';
  class?: string;
  /** Всё прочее уходит на элемент — в том числе data-astro-cid-* родителя. */
  [key: string]: unknown;
}

const { index = 0, as: Tag = 'div', class: className, ...rest } = Astro.props as Props;

/* 70 мс — шаг, при котором лесенка читается как одно движение группы.
   Потолок нужен для длинных списков: на девятой карточке задержка в 630 мс
   уже воспринимается как подтормаживание страницы, а не как анимация. */
const delay = Math.min(index * 70, 420);
---

<Tag class:list={['reveal', className]} style={`--reveal-delay: ${delay}ms`} {...rest}>
  <slot />
</Tag>
